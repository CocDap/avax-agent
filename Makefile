.PHONY: install infra api gateway indexer worker settler migrate revision test lint web web-build

install:            ## Install Python workspace + frontend deps
	uv sync --all-packages --all-extras
	pnpm install

infra:              ## Start Postgres + Redis
	docker compose up -d postgres redis

api:                ## Control plane REST API (http://localhost:8000/docs)
	cd apps/backend && uv run uvicorn app.main:app --reload --port 8000

gateway:            ## A2A gateway (http://localhost:8001)
	cd apps/backend && uv run uvicorn app.data_plane.gateway.main:app --reload --port 8001

indexer:            ## Chain indexer (Avalanche C-Chain event listener)
	cd apps/backend && uv run python -m app.data_plane.indexer

worker:             ## Job workers (arq on Redis)
	cd apps/backend && uv run arq app.data_plane.workers.settings.WorkerSettings

settler:            ## Settle bot
	cd apps/backend && uv run python -m app.data_plane.settler

migrate:            ## Apply DB migrations
	cd apps/backend && uv run alembic upgrade head

revision:           ## New autogenerated migration: make revision m="message"
	cd apps/backend && uv run alembic revision --autogenerate -m "$(m)"

test:
	cd apps/backend && uv run pytest
	cd packages/avaxagent-sdk && uv run pytest -q

lint:
	uv run ruff check apps/backend
	pnpm lint:web

web:                ## Frontend dev server (http://localhost:5173)
	pnpm dev:web

web-build:
	pnpm build:web
